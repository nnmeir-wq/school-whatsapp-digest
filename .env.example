# מפתח ה-API של קלוד (platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=

# נתיב מקומי לקובץ ה-JSON של ה-Service Account שהורדת מגוגל קלאוד
# (בהרצה מקומית זה נתיב לקובץ; ב-GitHub Actions זה יהיה תוכן ה-JSON עצמו כ-secret)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# ה-ID של גיליון גוגל שיטס (החלק שבין /d/ ל-/edit בכתובת הגיליון)
SPREADSHEET_ID=

# הגדרות SMTP לשליחת מייל דרך ג'ימייל
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# רשימת נמענים מופרדת בפסיקים
RECIPIENT_EMAILS=parent1@example.com,parent2@example.com

# מיפוי קבוצה -> ילד, כמחרוזת JSON אחת (בלי מעברי שורה)
GROUP_TO_CHILD_JSON={"שם הקבוצה כפי שמופיע בוואטסאפ": "שם הילד"}
