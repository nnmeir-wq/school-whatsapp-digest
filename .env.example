# מפתח ה-API של קלוד (platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=

# נתיב מקומי לקובץ ה-JSON של ה-Service Account שהורדת מגוגל קלאוד
# (בהרצה מקומית זה נתיב לקובץ; ב-GitHub Actions זה יהיה תוכן ה-JSON עצמו כ-secret)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# ה-ID של גיליון גוגל שיטס (החלק שבין /d/ ל-/edit בכתובת הגיליון)
